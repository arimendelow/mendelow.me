---
import Base from "@/layouts/Base.astro";
import { AboutStory, AgentsStory, Contact, Earlier, Hero, Now, RapidLinks, RapidPhoto, SpoonjoyStory, Work } from "@/components/sections";
import { RapidVideo } from "@/components/RapidVideo";
import { XrayToggle } from "@/components/XrayToggle";
import { OuroShowcase } from "@/components/OuroShowcase";

const title = "Ari Mendelow | Working with agents, and building for them";
const description = "Ari Mendelow works with agents every day and builds what they need, on Microsoft's Customer Innovation Team and in his own open-source workshop, Ouro, and his recipe app, Spoonjoy.";
// The card is generated from this page by scripts/social-card.mjs on every build; scripts/check-site.mjs holds these tags to it.
const cardAlt = "Ari Mendelow: I work with agents every day, and build what they need.";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://mendelow.me/#website", url: "https://mendelow.me/", name: "Ari Mendelow", description: "Working with agents, and building for them." },
    {
      "@type": "ProfilePage",
      "@id": "https://mendelow.me/#profilepage",
      url: "https://mendelow.me/",
      mainEntity: { "@type": "Person", name: "Ari Mendelow", url: "https://mendelow.me/", sameAs: ["https://www.linkedin.com/in/arimendelow", "https://github.com/arimendelow"] },
    },
  ],
};
---
<Base title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href="https://mendelow.me/">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Ari Mendelow">
    <meta property="og:url" content="https://mendelow.me/">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://mendelow.me/assets/social-card.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={cardAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://mendelow.me/assets/social-card.png">
    <meta name="twitter:image:alt" content={cardAlt}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <Hero />
  <Now />
  <AgentsStory />
  <Work>
    <OuroShowcase slot="showcase" client:visible />
    <XrayToggle slot="xray" client:visible />
  </Work>

  <section class="section about" id="about" aria-labelledby="about-heading">
    <div class="wrap about-grid">
      <AboutStory />
      <div class="about-media">
        <RapidPhoto />
        <RapidVideo client:visible />
      </div>
      <RapidLinks />
    </div>
  </section>

  <Earlier />
  <SpoonjoyStory />
  <Contact />

  <Fragment slot="end">
    <!-- Cloudflare Web Analytics, loaded only on the live site, so local and CI builds make no request to Cloudflare. -->
    <script is:inline>
      if (location.hostname === "mendelow.me") {
        const beacon = document.createElement("script");
        beacon.src = "https://static.cloudflareinsights.com/beacon.min.js";
        beacon.dataset.cfBeacon = '{"token": "dbc5c3f489694cfd8a3eb868154c414a"}';
        document.body.append(beacon);
      }
    </script>
  </Fragment>
</Base>
